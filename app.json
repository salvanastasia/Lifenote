{
  "expo": {
    "name": "LifeNote",
    "slug": "lifenote",
    "version": "1.0.0",
    "sdkVersion": "52.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#f2ede7"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lifenote.app",
      "runtimeVersion": "1.0.0"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f2ede7"
      },
      "package": "com.lifenote.app",
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {},
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/DMMono-Regular.ttf",
            "./assets/fonts/Handlee-Regular.ttf"
          ]
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "f3372275-8fd7-4dc5-aacc-b2052c5d3da7"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/f3372275-8fd7-4dc5-aacc-b2052c5d3da7"
    }
  }
}
